# libFuzzer dictionary for fuzz_glb -- GLB binary-container framing tokens (GLB_HEADER_MAGIC,
# chunk type tags) plus the glTF 2.0 JSON keywords that appear in the embedded JSON chunk.
# Single-line tokens only (see mayhem/fuzz_gltf/fuzz_gltf.dict header comment).

# --- GLB container framing (GLTFSDK/Inc/GLTFSDK/Constants.h) ---
"glTF"
"JSON"
"BIN\x00"

# --- glTF 2.0 JSON schema keywords (embedded JSON chunk) ---
"asset"
"version"
"2.0"
"scene"
"scenes"
"nodes"
"children"
"mesh"
"meshes"
"primitives"
"attributes"
"POSITION"
"NORMAL"
"TEXCOORD_0"
"indices"
"material"
"materials"
"pbrMetallicRoughness"
"baseColorFactor"
"baseColorTexture"
"metallicFactor"
"roughnessFactor"
"normalTexture"
"occlusionTexture"
"emissiveTexture"
"emissiveFactor"
"alphaMode"
"doubleSided"
"accessors"
"bufferView"
"bufferViews"
"buffer"
"buffers"
"byteOffset"
"byteLength"
"byteStride"
"componentType"
"count"
"type"
"SCALAR"
"VEC2"
"VEC3"
"VEC4"
"MAT4"
"min"
"max"
"sparse"
"images"
"textures"
"samplers"
"uri"
"mimeType"
"image/png"
"image/jpeg"
"data:,"
"animations"
"channels"
"sampler"
"target"
"path"
"translation"
